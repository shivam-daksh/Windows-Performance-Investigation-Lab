<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="Windows Performance Investigation Lab" Company="Performance Engineering" Copyright="2026" Comments="WPR Profile for CPU Contention and ETW Investigation">
  <Profiles>
    <!-- System Collector for NT Kernel Logger (CPU Sampling and Context Switches) -->
    <SystemCollector Id="SystemCollector_PerfLab" Name="NT Kernel Logger">
      <BufferSize Value="1024" />
      <Buffers Value="64" />
    </SystemCollector>

    <!-- Event Collector for User-Mode Providers -->
    <EventCollector Id="EventCollector_PerfLab" Name="PerfLab User Session">
      <BufferSize Value="1024" />
      <Buffers Value="64" />
    </EventCollector>

    <!-- System Provider: Kernel Scheduling, Context Switches, CPU Sampling -->
    <SystemProvider Id="SystemProvider_PerfLab">
      <Keywords>
        <Keyword Value="CpuConfig" />
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="SampledProfile" />
        <Keyword Value="ReadyThread" />
        <Keyword Value="CSwitch" />
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile" />
        <Stack Value="CSwitch" />
        <Stack Value="ReadyThread" />
      </Stacks>
    </SystemProvider>

    <!-- Application Custom TraceLogging Provider: Shivam.PerformanceInvestigationLab -->
    <!-- Provider GUID: {b0ee99b7-9835-4d51-933a-df6647dbd99f} -->
    <EventProvider Id="EventProvider_PerfLab" Name="b0ee99b7-9835-4d51-933a-df6647dbd99f" Level="5" NonPagedMemory="true">
      <Keywords>
        <Keyword Value="0xFFFFFFFFFFFFFFFF" />
      </Keywords>
    </EventProvider>

    <!-- Profile Definition: Verbose File Logging Mode -->
    <Profile Id="PerformanceLabProfile.Verbose.File"
             Name="PerformanceLabProfile"
             Description="Captures kernel CPU sampling, context switches, thread scheduling, and custom ETW application events directly to an ETL file"
             LoggingMode="File"
             DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SystemCollector_PerfLab">
          <SystemProviderId Value="SystemProvider_PerfLab" />
        </SystemCollectorId>
        <EventCollectorId Value="EventCollector_PerfLab">
          <EventProviders>
            <EventProviderId Value="EventProvider_PerfLab" />
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>

    <!-- Profile Definition: Verbose Memory Circular Buffer Mode -->
    <Profile Id="PerformanceLabProfile.Verbose.Memory"
             Name="PerformanceLabProfile"
             Description="Captures kernel CPU sampling, context switches, thread scheduling, and custom ETW application events in circular memory buffers"
             LoggingMode="Memory"
             DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SystemCollector_PerfLab">
          <SystemProviderId Value="SystemProvider_PerfLab" />
        </SystemCollectorId>
        <EventCollectorId Value="EventCollector_PerfLab">
          <EventProviders>
            <EventProviderId Value="EventProvider_PerfLab" />
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
